<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the single-file FactorySeat.exe, signed before Inno Setup packs it.
     GitHub Actions hands SignPath every artifact as a zip, hence the zip-file root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FactorySeat.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
