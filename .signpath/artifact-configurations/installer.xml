<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the Inno Setup installer, built around the already signed app.
     GitHub Actions hands SignPath every artifact as a zip, hence the zip-file root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FactorySeat-Setup-*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
