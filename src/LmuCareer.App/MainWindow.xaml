<Window x:Class="LmuCareer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Factory Seat"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F1A">
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0B0F1A" />
        <TextBlock x:Name="StartupMessage"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#C8CCD6" FontSize="16" TextWrapping="Wrap" MaxWidth="560"
                   TextAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Window>
