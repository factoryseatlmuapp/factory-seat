<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the app does behind its window, shared by the Windows (WPF + WebView2) and Linux (Photino) shells. -->

  <ItemGroup>
    <ProjectReference Include="..\LmuCareer.Core\LmuCareer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LmuCareer.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page and translations stay in LmuCareer.App, where translators and the docs expect them. -->
    <!-- The page is served out of the app; the resource name is its path under wwwroot. -->
    <EmbeddedResource Include="..\LmuCareer.App\wwwroot\**\*" LogicalName="wwwroot/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
    <!-- Translations, one file per language (see Locales.cs). -->
    <EmbeddedResource Include="..\LmuCareer.App\locales\*.json" Exclude="..\LmuCareer.App\locales\_*.json" LogicalName="locales/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
